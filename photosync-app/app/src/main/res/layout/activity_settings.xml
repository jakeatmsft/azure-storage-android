<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_mode_section"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/radioMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioModeUpload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_upload" />

            <RadioButton
                android:id="@+id/radioModeDownload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_download" />

            <RadioButton
                android:id="@+id/radioModeBoth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_mode_both" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_storage_access_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textStorageCredentialStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sas_not_configured" />

        <Button
            android:id="@+id/buttonScanSasQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_scan_sas_qr" />

        <Button
            android:id="@+id/buttonClearSas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_sas" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_sas_security_note" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_upload_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textUploadFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_upload_folders_empty" />

        <Button
            android:id="@+id/buttonAddUploadFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_add_upload_folder" />

        <Button
            android:id="@+id/buttonClearUploadFolders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_upload_folders" />

        <CheckBox
            android:id="@+id/checkUploadWifiOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi only" />

        <CheckBox
            android:id="@+id/checkUploadChargingOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Charging required" />

        <CheckBox
            android:id="@+id/checkUploadIncludeVideos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_include_videos" />

        <CheckBox
            android:id="@+id/checkUploadChecksum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate SHA-256 checksum" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_download_section"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonChooseDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_choose_destination" />

        <TextView
            android:id="@+id/textDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <CheckBox
            android:id="@+id/checkDownloadWifiOnly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wi-Fi only" />

        <CheckBox
            android:id="@+id/checkDownloadOverwrite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Overwrite conflicting files" />

        <TextView
            android:id="@+id/textDownloadMinFreePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/seekDownloadMinFreePercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="98" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_download_min_free_space_help" />

    </LinearLayout>
</ScrollView>
